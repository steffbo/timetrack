# Database configuration
DB_URL=jdbc:postgresql://localhost:5432/timetrack
DB_USERNAME=timetrack
DB_PASSWORD=timetrack

# Server configuration
SERVER_PORT=8080
MANAGEMENT_PORT=7080
APP_FRONTEND_BASE_URL=http://localhost:5173

# JWT configuration
JWT_SECRET=your-secret-key-change-this-in-production-must-be-at-least-32-bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=15552000000

# Security and logging
ALLOWED_ORIGINS=*
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_CC_REMER_TIMETRACK=DEBUG
